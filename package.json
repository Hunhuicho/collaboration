{
  "name": "review-board",
  "version": "1.0.0",
  "private": true,
  "description": "Shared-passcode review board: Yes/No plus comments per item (Cloudflare Pages + Firestore)",
  "scripts": {
    "dev": "wrangler pages dev public --port 8788",
    "serve": "python3 -m http.server 8080 --directory public",
    "deploy": "wrangler pages deploy public --project-name collaboration-a43",
    "rules": "firebase deploy --only firestore:rules",
    "bundle": "node tools/inline.mjs"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
