rules_version = '2';

// ------------------------------------------------------------------
// Review Board — Firestore security rules
//
// Access model
//  · Identity: anonymous auth. No personal data — just a per-browser uid.
//  · Control: the SHA-256 hash of the shared passcode IS the room path
//    (rooms/{room}). Without the passcode you cannot construct the path,
//    so you cannot reach that room's data.
//  · Write: only to your own uid document. Nobody can edit another
//    reviewer's reply.
//  · Read: everyone in the room (same passcode) can read every reply —
//    seeing each other's comments is the point. Do not put confidential
//    material here.
// ------------------------------------------------------------------
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    match /rooms/{room} {

      // Workspace label. Created once by whoever enters first, then frozen.
      match /meta/{metaId} {
        allow get: if signedIn();
        allow create: if signedIn()
          && request.resource.data.keys().hasOnly(['label', 'createdAt'])
          && request.resource.data.label is string
          && request.resource.data.label.size() > 0
          && request.resource.data.label.size() <= 60;
        allow update, delete: if false;
      }

      // One reply per reviewer per document. Document ID = author uid.
      match /docs/{docId}/responses/{uid} {
        allow read: if signedIn();

        allow create, update: if signedIn()
          && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['answers', 'overall', 'updatedAt'])
          && request.resource.data.answers is map
          && request.resource.data.answers.size() <= 200
          && request.resource.data.overall is string
          && request.resource.data.overall.size() <= 4000
          && request.resource.data.updatedAt is timestamp;

        allow delete: if signedIn() && request.auth.uid == uid;
      }
    }
  }
}
