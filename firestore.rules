rules_version = '2';

// ------------------------------------------------------------------
// Review Board — Firestore security rules
//
// Access model
//  · Identity: anonymous auth. No personal data — just a per-browser uid.
//  · Control: the SHA-256 hash of the shared passcode IS the room path
//    (rooms/{room}). Without the passcode you cannot construct the path,
//    so you cannot reach that room's data.
//  · Data: one shared document per investigation. Everyone on the
//    passcode reads and writes the same document — whoever fills a field
//    in, everyone sees it. There is no per-person copy and no read-only
//    role. Do not put confidential material here.
// ------------------------------------------------------------------
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    match /rooms/{room} {

      // Workspace label. Created once by whoever enters first, then frozen.
      match /meta/{metaId} {
        allow get: if signedIn();
        allow create: if signedIn()
          && request.resource.data.keys().hasOnly(['label', 'createdAt'])
          && request.resource.data.label is string
          && request.resource.data.label.size() > 0
          && request.resource.data.label.size() <= 60;
        allow update, delete: if false;
      }

      // The shared document for one investigation. Everyone edits this.
      //
      // Writes carry an updateMask naming only the items that changed, so two
      // people working on different items at once do not overwrite each other.
      // A masked write that touches no conclusion leaves 'overall' out
      // altogether, so each field is checked only when it is actually there —
      // hasOnly() still keeps anything unexpected out.
      match /docs/{docId} {
        allow read: if signedIn();

        allow create, update: if signedIn()
          && request.resource.data.keys().hasOnly(['answers', 'overall', 'updatedAt'])
          && request.resource.data.updatedAt is timestamp
          && (
               !('answers' in request.resource.data)
               || (request.resource.data.answers is map
                   && request.resource.data.answers.size() <= 200)
             )
          && (
               !('overall' in request.resource.data)
               || (request.resource.data.overall is string
                   && request.resource.data.overall.size() <= 4000)
             );

        allow delete: if false;
      }

      // The old per-person replies. Readable, so entries written before the
      // switch to a shared document can be folded in once; not writable, so a
      // stale page still open somewhere fails loudly instead of quietly
      // filing entries where nobody will ever see them.
      match /docs/{docId}/responses/{uid} {
        allow read: if signedIn();
        allow write: if false;
      }
    }
  }
}
